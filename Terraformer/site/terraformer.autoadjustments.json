{
  "schema": "TERRAFORMER-AUTO-ADJUSTMENT/1",
  "version": "0.47.43",
  "capabilities": {
    "autoAdjust": {
      "target": "DEFAULT",
      "requires": "admitted transition or bounded policy",
      "silentPersistence": false
    },
    "autoReadjust": {
      "target": "CUSTOMIZED",
      "requires": "admitted user customization and transition",
      "silentPersistence": false
    }
  },
  "modeTransitions": [
    {
      "from": "CUSTOMIZED",
      "to": "DEFAULT",
      "operation": "AUTO_ADJUST",
      "userControllable": true
    },
    {
      "from": "DEFAULT",
      "to": "CUSTOMIZED",
      "operation": "AUTO_READJUST",
      "userControllable": true
    }
  ],
  "defaultsSource": "terraformer.defaults.json",
  "customizationSource": "terraformer.customizations.json",
  "authorityGranted": false,
  "automaticAuthority": false
}
