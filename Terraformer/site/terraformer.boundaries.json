    "RESOURCING",
    "PUBLICITY",
    "PRIVACY"
  ],
  "boundarySemantics": {
    "USER": "identity/governance scope; no authority by declaration",
    "MACHINE": "machine/runtime-host scope; no hardware or OS authority by declaration",
    "GROUP": "grouping/membership scope; no membership or permission by declaration",
    "DIMENSION": "dimensional classification scope; no state or qualification by declaration",
    "HOSTING": "hosting scope; hosting does not imply farming, pooling, resourcing, publicity, persistence, deployment, network exposure, or authority",
    "FARMING": "coordinated work/resource scope; farming does not imply hosting, pooling, resourcing, publicity, persistence, background execution, or authority",
    "POOLING": "resource aggregation scope; pooling is private by default and does not imply sharing, hosting, farming, resourcing, publicity, persistence, execution, or authority",
    "RESOURCING": "resource supply/assignment scope; resourcing does not imply ownership, hosting, farming, pooling, publicity, persistence, execution, or authority",
    "PUBLICITY": "admitted public exposure/projection scope; publicity requires an explicit admitted transition and does not arise from hosting, farming, pooling, or resourcing",
    "PRIVACY": "restricted exposure/non-disclosure scope; privacy does not itself grant authority and an authorized public transition must cross the publicity/privacy boundary explicitly"
  },
