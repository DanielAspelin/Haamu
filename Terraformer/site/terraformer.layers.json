{
  "schema": "TERRAFORMER-LAYER-ARCHITECTURE/1",
  "version": "0.47.84",
  "developmentOrder": [
    "system.platform",
    "system.system",
    "system.application",
    "system.program"
  ],
  "userProjection": [
    "system.program",
    "system.application",
    "system.system"
  ],
  "invariants": {
    "systemsImplementedFirst": true,
    "applicationsComposeSystems": true,
    "programsComposeApplications": true,
    "programIsPrimaryVisualizationBoundary": true,
    "systemsHiddenBehindApplicationsByDefault": true,
    "morphologyCreatesCandidatesOnly": true,
    "privatePlatformPrecedesSystems": true,
    "targetPlatformDeliveryExplicit": true
  },
  "linguist": {
    "tokenDiscovery": true,
    "systemCandidateSuffixes": [
      "ion",
      "ing"
    ],
    "workerCandidateFinal": "r",
