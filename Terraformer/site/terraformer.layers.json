  },
  "authorityGranted": false,
  "automaticExecution": false,
  "automaticNaturalization": false,
  "deliveryOrder": [
    "system.program",
    "system.delivery",
    "system.platform"
  ],
  "platformProjection": {
    "construction": {
      "classification": "PRIVATE",
      "role": "internal-foundation"
    },
    "delivery": {
      "classification": "TARGET",
      "privacyPublicity": "ORTHOGONAL"
    },
    "samePlatformSystem": true,
    "automaticPublication": false,
    "automaticDelivery": false
  },
  "owner": "system.layer",
  "ownerBindingVersion": "0.48.16",
  "ownerBindingAuthorityGranted": false
}
